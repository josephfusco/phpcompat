{
	"name": "wpengine/phpcompat-phpcs-bundle",
	"description": "PHP_CodeSniffer and PHPCompatibilityWP, zipped into the plugin and run in the browser on PHP WebAssembly (WordPress Playground).",
	"license": "GPL-2.0-or-later",
	"minimum-stability": "alpha",
	"prefer-stable": true,
	"require": {
		"squizlabs/php_codesniffer": "4.0.4",
		"phpcsstandards/phpcsutils": "1.2.3",
		"phpcompatibility/php-compatibility": "10.0.0-alpha2",
		"phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
		"phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3.0"
		}
	}
}
