{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "PHP Compatibility Checker 2.0.0 beta 3",
    "author": "josephfusco"
  },
  "landingPage": "/wp-admin/tools.php?page=wpe-php-compat",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://wordpress-playground-cors-proxy.net/?https://github.com/josephfusco/phpcompat/releases/download/v2.0.0-beta.3/php-compatibility-checker.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "classic-editor"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "broken-link-checker"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; // Broken Link Checker redirects to its own dashboard on the first admin load after activation; land on the checker instead.\ndelete_transient( 'blc_activation_redirect' );"
    }
  ]
}
