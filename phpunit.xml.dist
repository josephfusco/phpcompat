<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="tests/bootstrap.php" backupGlobals="false" colors="true" failOnWarning="true" failOnDeprecation="true">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">./plugin</directory>
    </include>
  </source>
</phpunit>
