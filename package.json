{
	"name": "wpe-php-compat",
	"description": "The WP Engine PHP Compatibility Checker can be used by any WordPress website on any web host to check PHP version compatibility.",
	"repository": {
		"type": "git",
		"url": "https://github.com/wpengine/phpcompat"
	},
	"author": "WP Engine <wptech@wpengine.com>",
	"license": "GPLv2",
	"homepage": "https://wpengine.com",
	"scripts": {
		"build": "wp-scripts build --output-path=plugin/build && cp readme.txt plugin/",
		"start": "wp-scripts start --output-path=plugin/build",
		"wp-env": "wp-env",
		"lint:js": "wp-scripts lint-js src tests/e2e eslint.config.js postcss.config.js playwright.config.js",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss'",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:debug": "wp-scripts test-playwright --debug"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/postcss-plugins-preset": "^6.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/theme": "^3.0.0",
		"cssnano": "^8.0.10"
	},
	"dependencies": {
		"@wordpress/i18n": "^7.0.0",
		"compare-versions": "^6.1.0",
		"mustache": "^4.2.0"
	},
	"overrides": {
		"minimatch": "^9.0.9",
		"serialize-javascript": "^7.0.3",
		"yauzl": "3.2.1",
		"webpack-dev-server": "5.2.4",
		"ws": "8.21.0",
		"fast-xml-builder": "1.2.0",
		"qs": "6.15.2",
		"@babel/plugin-transform-modules-systemjs": "7.29.4",
		"tmp": "0.2.7",
		"js-yaml": "4.2.0",
		"markdown-it": "14.2.0",
		"uuid": "11.1.1"
	}
}
